{
    "app-id": "io.github.sotirismorf.Recto",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable",
        "org.freedesktop.Sdk.Extension.llvm20"
    ],
    "command": "recto",
    "finish-args": [
        "--socket=wayland",
        "--socket=fallback-x11",
        "--share=ipc",
        "--device=dri",
        "--filesystem=home",
        "--own-name=io.github.sotirismorf.Recto"
    ],
    "modules": [
        {
            "name": "opencv",
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=Release",
                "-DBUILD_LIST=core,imgproc,imgcodecs,geometry",
                "-DBUILD_opencv_apps=OFF",
                "-DBUILD_EXAMPLES=OFF",
                "-DBUILD_PACKAGE=OFF",
                "-DBUILD_TESTS=OFF",
                "-DBUILD_PERF_TESTS=OFF",
                "-DBUILD_opencv_python3=OFF",
                "-DBUILD_opencv_java=OFF",
                "-DWITH_GTK=OFF",
                "-DWITH_OPENCL=OFF",
                "-DWITH_CUDA=OFF",
                "-DWITH_OPENEXR=OFF",
                "-DWITH_FFMPEG=OFF",
                "-DWITH_GSTREAMER=OFF",
                "-DWITH_1394=OFF",
                "-DWITH_V4L=OFF",
                "-DOPENCV_GENERATE_PKGCONFIG=ON"
            ],
            "cleanup": [
                "/bin",
                "/share/opencv5",
                "/include/opencv5/opencv2/cvconfig.h"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/opencv/opencv/archive/5.0.0.tar.gz",
                    "sha256": "b0528f5a1d379d59d4701cb28c36e22214cc51cf64594e5b56f2d3e6c0233095"
                }
            ]
        },
        {
            "name": "recto",
            "buildsystem": "simple",
            "build-options": {
                "append-path": "/usr/lib/sdk/rust-stable/bin:/usr/lib/sdk/llvm20/bin",
                "env": {
                    "CARGO_HOME": "/run/build/recto/cargo",
                    "LIBCLANG_PATH": "/usr/lib/sdk/llvm20/lib"
                }
            },
            "sources": [
                {
                    "type": "dir",
                    "path": ".."
                },
                "cargo-sources.json"
            ],
            "build-commands": [
                "mkdir -p .cargo",
                "cat > .cargo/config.toml <<'EOF'\n[source.crates-io]\nreplace-with = \"vendored-sources\"\n\n[source.vendored-sources]\ndirectory = \"cargo/vendor\"\nEOF",
                "cargo build --release --offline",
                "install -Dm755 target/release/recto /app/bin/recto",
                "install -Dm644 flatpak/io.github.sotirismorf.Recto.desktop /app/share/applications/io.github.sotirismorf.Recto.desktop",
                "install -Dm644 crates/ui/src/logo.svg /app/share/icons/hicolor/scalable/apps/io.github.sotirismorf.Recto.svg",
                "install -Dm644 flatpak/io.github.sotirismorf.Recto.xml /app/share/mime/packages/io.github.sotirismorf.Recto.xml",
                "update-mime-database /app/share/mime"
            ]
        }
    ]
}
